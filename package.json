{
  "name": "skywake",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source, privacy-first live flight tracker",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint --deny-warnings",
    "airports": "node scripts/build-airports.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
