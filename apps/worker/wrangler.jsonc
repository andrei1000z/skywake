{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "skywake-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.05 },
  "durable_objects": {
    "bindings": [{ "name": "GATE", "class_name": "UpstreamGate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UpstreamGate"] }],
  // Per-client limit on edge-cache misses. Period must be 10 or 60 seconds.
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }],
  "vars": {
    "VERSION": "0.1.0",
    // Exact browser origins allowed by CORS, comma separated (localhost and Capacitor are built in).
    "ALLOWED_ORIGINS": "https://andrei1000z.github.io",
    // Upstream budget for ADSB.lol, deliberately below its published per-IP limits (4/s, 60/min).
    "UPSTREAM_RPS": "0.75",
    "UPSTREAM_BURST": "3",
    "UPSTREAM_PER_MIN": "40",
    "UPSTREAM_PER_DAY": "0",
    "USER_AGENT": "Skywake/0.1 (+https://github.com/andrei1000z/skywake)"
  }
}
